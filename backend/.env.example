# Copy to backend/.env and fill in. The app runs WITHOUT this key —
# chat degrades to a clear "add your key" state; memory keeps working.
GROQ_API_KEY=

# optional model override (default: openai/gpt-oss-120b)
GROQ_MODEL=

# Optional: premium JARVIS voice. Without it, the browser's speechSynthesis is used.
ELEVENLABS_API_KEY=
# Optional voice override (default: Daniel)
ELEVENLABS_VOICE=
