{
  "name": "echo-assistant",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "app": "electron .",
    "app:build": "npm run build && electron-builder --mac dir"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "gifenc": "^1.0.3",
    "html2canvas": "^1.4.1",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "main": "desktop/main.js",
  "build": {
    "appId": "dev.umair.jarvis",
    "productName": "JARVIS",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "desktop/**",
      "build/icon.png"
    ],
    "mac": {
      "target": "dir",
      "icon": "build/icon.png",
      "category": "public.app-category.productivity"
    },
    "electronDist": "node_modules/electron/dist",
    "electronVersion": "37.10.3"
  }
}